---
import nav from '../data/nav.json';
import site from '../data/site.json';
import OpenStatus from './OpenStatus.astro';

type NavItem = { title: string; href: string; children?: NavItem[] };
const sections = (nav as NavItem[]).filter((n) => n.href !== '/');
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (item: NavItem): boolean =>
  item.href === path || (item.children ?? []).some(isActive);
const townHall = site.hours.find((h) => h.id === 'town-hall')!;
---
<div class="utility">
  <div class="wrap utility-inner">
    <span>{site.address.street}, {site.address.city}, {site.address.state} {site.address.zip}</span>
    <a href={`tel:${site.phone.replace(/\D/g, '')}`}>{site.phone}</a>
    <span class="utility-status">Town Hall <OpenStatus schedule={townHall.schedule} /></span>
    <a href="/hours" class="utility-hours">Hours</a>
  </div>
</div>
<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label="Town of New Gloucester, Maine home">
      <img class="brand-mark" src="/media/brand/town-seal.png" alt="" width="56" height="56" />
      <span class="brand-text">
        <span class="brand-top">Town of</span>
        <span class="brand-name">New Gloucester</span>
        <span class="brand-state">Maine</span>
      </span>
    </a>

    <nav class="primary-nav" aria-label="Main">
      <ul class="nav-list">
        {sections.map((s) => {
          const groups = (s.children ?? []).filter((c) => c.children?.length);
          const singles = (s.children ?? []).filter((c) => !c.children?.length);
          return (
            <li class="nav-item">
              <details class="nav-details" data-nav>
                <summary class:list={['nav-top', { active: isActive(s) }]}>{s.title}<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" /></svg></summary>
                <div class:list={['mega', { wide: groups.length > 0 }]}>
                  <div class="mega-inner">
                    <div class="mega-col">
                      <a class="mega-overview" href={s.href}>{s.title} overview <span aria-hidden="true">&rarr;</span></a>
                      <ul>
                        {singles.map((c) => <li><a href={c.href} aria-current={c.href === path ? 'page' : undefined}>{c.title}</a></li>)}
                      </ul>
                    </div>
                    {groups.map((g) => (
                      <div class="mega-col">
                        <a class="mega-heading" href={g.href}>{g.title}</a>
                        <ul>
                          {g.children!.map((c) => <li><a href={c.href}>{c.title}</a></li>)}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </details>
            </li>
          );
        })}
        <li class="nav-item"><a class="nav-top" href="/meetings">Meetings &amp; Documents</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <a class="search-btn" href="/search" aria-label="Search the site">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" /><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <span>Search</span>
      </a>
      <a class="btn btn-primary pay-btn" href="/online-services">Pay &amp; Register</a>
      <button class="menu-btn" aria-expanded="false" aria-controls="mobile-nav">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <span>Menu</span>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="mobile-nav" hidden>
    <div class="wrap">
      <form action="/search" class="mobile-search" role="search">
        <label for="m-q" class="visually-hidden">Search</label>
        <input id="m-q" name="q" type="search" placeholder="Search the site" />
        <button class="btn btn-primary" type="submit">Search</button>
      </form>
      <ul>
        <li><a href="/meetings" class="m-top">Meetings &amp; Documents</a></li>
        {sections.map((s) => (
          <li>
            <details>
              <summary class="m-top">{s.title}</summary>
              <ul class="m-sub">
                <li><a href={s.href}>{s.title} overview</a></li>
                {(s.children ?? []).map((c) => (
                  <li>
                    <a href={c.href}>{c.title}</a>
                    {c.children?.length ? (
                      <ul class="m-sub2">{c.children.map((g) => <li><a href={g.href}>{g.title}</a></li>)}</ul>
                    ) : null}
                  </li>
                ))}
              </ul>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </div>
</header>

<script>
  // Desktop mega menu: only one open at a time, close on outside click / Escape.
  const all = Array.from(document.querySelectorAll<HTMLDetailsElement>('details[data-nav]'));
  all.forEach((d) =>
    d.addEventListener('toggle', () => {
      if (d.open) all.forEach((o) => o !== d && (o.open = false));
    }),
  );
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('details[data-nav]')) all.forEach((d) => (d.open = false));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const open = all.find((d) => d.open);
      if (open) { open.open = false; open.querySelector('summary')?.focus(); }
    }
  });
  // Mobile menu toggle
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const panel = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
  });
</script>

<style>
  .utility { background: var(--pine-900); color: #dfe9e2; font-size: .85rem; }
  .utility-inner { max-width: 1440px; display: flex; gap: 1.25rem; align-items: center; justify-content: flex-end; padding-block: .4rem; flex-wrap: wrap; }
  .utility a { color: #fff; text-decoration: none; }
  .utility a:hover { text-decoration: underline; color: #fff; }
  .utility-status { display: inline-flex; gap: .4rem; align-items: center; }
  @media (max-width: 720px) { .utility-inner > span:first-child { display: none; } .utility-inner { justify-content: space-between; } }

  .site-header { background: var(--card); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 50; }
  .header-inner { max-width: 1440px; display: flex; align-items: center; gap: 1rem; min-height: 78px; }
  .brand { display: flex; align-items: center; gap: .7rem; text-decoration: none; color: var(--pine-900); flex-shrink: 0; }
  .brand-mark { width: 56px; height: 56px; }
  .brand-text { display: grid; line-height: 1.05; }
  .brand-top, .brand-state { font-size: .72rem; text-transform: uppercase; letter-spacing: .16em; color: var(--muted); font-weight: 700; }
  .brand-name { font-family: var(--font-serif); font-size: 1.45rem; font-weight: 650; }

  .primary-nav { flex: 1; }
  .nav-list { list-style: none; display: flex; gap: .15rem; margin: 0; padding: 0; justify-content: center; }
  .nav-item { position: static; }
  .nav-top { display: inline-flex; align-items: center; gap: .3rem; padding: .55rem .65rem; border-radius: 999px; font-weight: 650; color: var(--ink); text-decoration: none; cursor: pointer; list-style: none; font-size: .98rem; white-space: nowrap; }
  .nav-top::-webkit-details-marker { display: none; }
  .nav-top svg { width: 12px; height: 12px; transition: transform .2s; }
  .nav-top:hover, details[open] > .nav-top { background: var(--pine-100); color: var(--pine-900); }
  details[open] > .nav-top svg { transform: rotate(180deg); }
  .nav-top.active { color: var(--pine-700); box-shadow: inset 0 -3px 0 var(--harvest); border-radius: 0; }

  .mega { position: absolute; left: 0; right: 0; top: 100%; background: var(--card); border-top: 1px solid var(--line); box-shadow: var(--shadow-lg); }
  .mega-inner { max-width: var(--wrap); margin: 0 auto; padding: 1.5rem clamp(1rem, 3vw, 2rem) 2rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem 2rem; max-height: 70vh; overflow: auto; }
  .mega ul { list-style: none; margin: 0; padding: 0; }
  .mega li a { display: block; padding: .3rem 0; color: var(--ink); text-decoration: none; font-size: .95rem; }
  .mega li a:hover { color: var(--barn); text-decoration: underline; }
  .mega-overview, .mega-heading { display: block; font-family: var(--font-serif); font-weight: 650; font-size: 1.1rem; color: var(--pine-800); text-decoration: none; margin-bottom: .5rem; padding-bottom: .4rem; border-bottom: 2px solid var(--harvest); }

  .header-actions { display: flex; align-items: center; gap: .6rem; }
  .search-btn { display: inline-flex; align-items: center; gap: .35rem; color: var(--ink); text-decoration: none; font-weight: 600; padding: .5rem .7rem; border-radius: 999px; }
  .search-btn:hover { background: var(--pine-100); color: var(--pine-900); }
  .search-btn svg, .menu-btn svg { width: 22px; height: 22px; }
  .menu-btn { display: none; align-items: center; gap: .35rem; background: none; border: 1px solid var(--line); border-radius: 999px; padding: .45rem .8rem; font: inherit; font-weight: 600; color: var(--ink); cursor: pointer; }

  .mobile-nav { border-top: 1px solid var(--line); background: var(--card); max-height: calc(100vh - 110px); overflow: auto; padding-bottom: 1.5rem; }
  .mobile-nav ul { list-style: none; margin: 0; padding: 0; }
  .m-top { display: block; padding: .85rem 0; font-weight: 700; border-bottom: 1px solid var(--line); cursor: pointer; color: var(--ink); text-decoration: none; }
  .m-sub { padding: .25rem 0 .75rem 1rem !important; }
  .m-sub a { display: block; padding: .4rem 0; color: var(--pine-700); }
  .m-sub2 { padding-left: 1rem !important; font-size: .95rem; }
  .mobile-search { display: flex; gap: .5rem; padding: 1rem 0; }
  .mobile-search input { flex: 1; padding: .7rem 1rem; border: 1px solid var(--line); border-radius: 999px; font: inherit; }

  .pay-btn { white-space: nowrap; }
  @media (max-width: 480px) { .brand-mark { width: 44px; height: 44px; } .brand-name { font-size: 1.2rem; } .header-inner { gap: .5rem; } .menu-btn span { display: none; } .header-actions { gap: .2rem; } }
  @media (max-width: 1440px) { .search-btn span { display: none; } }
  @media (max-width: 1300px) { .brand-name { font-size: 1.25rem; } .nav-top { font-size: .93rem; padding-inline: .55rem; } }
  @media (max-width: 1180px) {
    .primary-nav, .pay-btn, .search-btn span { display: none; }
    .menu-btn { display: inline-flex; }
    .header-actions { margin-left: auto; }
  }
</style>
