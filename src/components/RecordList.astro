---
import { recordById, recordHref, formatDate, type RecordItem } from '../lib/data';

interface Props { ids: string[] }
const items = Astro.props.ids.map((id) => recordById.get(id)).filter(Boolean) as RecordItem[];
const years = [...new Set(items.map((r) => r.date?.slice(0, 4)).filter(Boolean))].sort().reverse() as string[];
const filterable = items.length > 12;
const listId = `rl-${Math.random().toString(36).slice(2, 8)}`;
const typeClass = (t: string) => t.toLowerCase().replace(/\s+/g, '-');
---
<div class="record-list-wrap" data-record-list={filterable ? '' : undefined}>
  {filterable && (
    <div class="rl-filters" role="search">
      <label class="visually-hidden" for={`${listId}-q`}>Filter these documents</label>
      <input id={`${listId}-q`} type="search" placeholder={`Filter ${items.length} items…`} data-q />
      {years.length > 1 && (
        <>
          <label class="visually-hidden" for={`${listId}-y`}>Year</label>
          <select id={`${listId}-y`} data-year>
            <option value="">All years</option>
            {years.map((y) => <option value={y}>{y}</option>)}
          </select>
        </>
      )}
      <span class="rl-count" aria-live="polite" data-count></span>
    </div>
  )}
  <ul class="rl">
    {items.map((r) => {
      const href = recordHref(r);
      const file = !r.path && r.attachments[0];
      return (
        <li data-text={r.title.toLowerCase()} data-year={r.date?.slice(0, 4) ?? ''}>
          <a href={href} class="rl-link">
            <span class:list={['rl-type', typeClass(r.kind === 'item' ? r.docType : r.kind)]}>{r.kind === 'item' ? r.docType : r.kind}</span>
            <span class="rl-title">{r.title}</span>
            <span class="rl-meta">
              {r.date && <time datetime={r.date}>{formatDate(r.date, 'short')}</time>}
              {file && <span class="rl-ext">{file.ext.toUpperCase()}</span>}
              {r.path && r.attachments.length > 0 && <span class="rl-ext">{r.attachments.length} file{r.attachments.length > 1 ? 's' : ''}</span>}
            </span>
          </a>
          {r.summary && <div class="rl-summary" set:html={r.summary} />}
        </li>
      );
    })}
  </ul>
  {filterable && <p class="rl-empty" hidden data-empty>No items match that filter.</p>}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-record-list]').forEach((wrap) => {
    const q = wrap.querySelector<HTMLInputElement>('[data-q]');
    const y = wrap.querySelector<HTMLSelectElement>('[data-year]');
    const count = wrap.querySelector<HTMLElement>('[data-count]');
    const empty = wrap.querySelector<HTMLElement>('[data-empty]');
    const rows = Array.from(wrap.querySelectorAll<HTMLLIElement>('li[data-text]'));
    const run = () => {
      const terms = (q?.value ?? '').toLowerCase().split(/\s+/).filter(Boolean);
      const year = y?.value ?? '';
      let shown = 0;
      rows.forEach((li) => {
        const ok = terms.every((t) => li.dataset.text!.includes(t)) && (!year || li.dataset.year === year);
        li.hidden = !ok;
        if (ok) shown++;
      });
      if (count) count.textContent = terms.length || year ? `${shown} of ${rows.length}` : '';
      if (empty) empty.hidden = shown > 0;
    };
    q?.addEventListener('input', run);
    y?.addEventListener('change', run);
  });
</script>

<style>
  .record-list-wrap { margin: 1rem 0 2rem; max-width: none; }
  .rl-filters { display: flex; gap: .6rem; flex-wrap: wrap; align-items: center; margin-bottom: .8rem; }
  .rl-filters input, .rl-filters select { font: inherit; padding: .55rem .9rem; border: 1px solid var(--line); border-radius: 999px; background: #fff; }
  .rl-filters input { flex: 1; min-width: 200px; }
  .rl-count { color: var(--muted); font-size: .9rem; }
  .rl { list-style: none; padding: 0; margin: 0; border: 1px solid var(--line); border-radius: var(--radius); background: var(--card); overflow: hidden; }
  .rl li { border-top: 1px solid var(--line); margin: 0; }
  .rl li:first-child { border-top: 0; }
  .rl-link { display: grid; grid-template-columns: 7.5rem 1fr auto; gap: .8rem; align-items: center; padding: .75rem 1rem; text-decoration: none; color: var(--ink); }
  .rl-link:hover { background: var(--pine-100); color: var(--ink); }
  .rl-link:hover .rl-title { text-decoration: underline; color: var(--pine-800); }
  .rl-type { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; padding: .2rem .5rem; border-radius: 6px; background: #eef0ee; color: #445; justify-self: start; }
  .rl-type.agenda { background: #e3eefc; color: #1d4f91; }
  .rl-type.agenda-packet { background: #ece6fb; color: #4b2f91; }
  .rl-type.minutes { background: #e2f3e6; color: #1f6b38; }
  .rl-type.notice { background: #fdf0d7; color: #7a4d00; }
  .rl-type.news, .rl-type.event, .rl-type.job { background: var(--harvest-100); color: #7a4d00; }
  .rl-title { font-weight: 550; }
  .rl-meta { display: flex; gap: .6rem; align-items: center; color: var(--muted); font-size: .88rem; white-space: nowrap; }
  .rl-ext { font-size: .72rem; font-weight: 700; border: 1px solid var(--line); border-radius: 4px; padding: 0 .35rem; }
  .rl-summary { padding: 0 1rem .75rem 9.3rem; color: var(--muted); font-size: .92rem; }
  .rl-summary :global(h4) { display: inline; font-size: inherit; font-family: inherit; margin: 0 .3rem 0 0; color: inherit; }
  .rl-summary :global(div) { display: inline; }
  .rl-empty { color: var(--muted); }
  @media (max-width: 640px) {
    .rl-link { grid-template-columns: 1fr; gap: .3rem; }
    .rl-summary { padding-left: 1rem; }
  }
</style>
