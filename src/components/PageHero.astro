---
interface Props { title: string; crumbs?: { title: string; href: string }[]; eyebrow?: string }
const { title, crumbs = [], eyebrow } = Astro.props;
---
<section class="page-hero">
  <div class="wrap">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="crumbs">
        <ol>
          {crumbs.map((c) => <li><a href={c.href}>{c.title}</a></li>)}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow hero-eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <slot />
  </div>
</section>
<style>
  .page-hero { background: linear-gradient(120deg, var(--pine-800), var(--pine-700)); color: #fff; padding: 2rem 0 2.25rem; position: relative; overflow: hidden; }
  .page-hero::after { content: ''; position: absolute; inset: auto -5% -60px auto; width: 420px; height: 160px; background: radial-gradient(closest-side, rgb(224 164 58 / .28), transparent); pointer-events: none; }
  .page-hero h1 { color: #fff; margin: .2rem 0 0; max-width: 30ch; }
  .crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: .3rem; padding: 0; margin: 0 0 .6rem; font-size: .9rem; }
  .crumbs li:not(:last-child)::after { content: '/'; margin-left: .4rem; opacity: .5; }
  .crumbs a { color: #d6e6db; text-decoration: none; }
  .crumbs a:hover { color: #fff; text-decoration: underline; }
  .hero-eyebrow { color: var(--harvest); }
</style>
